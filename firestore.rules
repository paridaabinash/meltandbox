rules_version = '2';

// Melt & Box Co. — Firestore security rules.
// Publish: Firebase Console → Firestore Database → Rules → paste → Publish
//      or: npx firebase-tools deploy --only firestore:rules
//
// Data:
//   users/{uid}       a customer's saved checkout details (only they + the owner can read)
//   orders/{orderId}  one order; `uid` = customer who placed it
//   settings/shop     owner-only shop settings (UPI ID); settings/catalog = last "Publish" click
//   products/{slug}   the catalogue (public read, owner-only write); the website reads it at build time
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner access (shop owner's Google account UID). To add another admin, append their UID (shown at /admin) and publish.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['DEV7zs6GWjSejA2PpnrbQsQQRUh1', 'gBQdLare0NVcXfZ4g16l1CcmKmh2'];
    }

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Field checks shared by orders.customer and users/{uid}.
    function validContactFields(c) {
      return str(c.name, 2, 80)
        && str(c.phone, 10, 10) && c.phone.matches('[6-9][0-9]{9}')
        && c.whatsapp is bool
        && str(c.email, 0, 120)
        && str(c.address, 8, 400)
        && str(c.city, 1, 60)
        && str(c.pincode, 6, 6) && c.pincode.matches('[1-9][0-9]{5}')
        && str(c.state, 0, 60);
    }

    function validCustomer(c) {
      let keys = ['name', 'phone', 'whatsapp', 'email', 'address', 'city', 'pincode', 'state'];
      return c is map && c.keys().hasOnly(keys) && c.keys().hasAll(keys) && validContactFields(c);
    }

    function validProfile(d) {
      let keys = ['name', 'phone', 'whatsapp', 'email', 'address', 'city', 'pincode', 'state', 'updatedAt'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && validContactFields(d)
        && d.updatedAt == request.time;
    }

    function validNewOrder(id) {
      let d = request.resource.data;
      let keys = ['uid', 'accountEmail', 'customer', 'items', 'subtotal', 'freeMiniCandle', 'freeShipping', 'contactConsent', 'note', 'status', 'createdAt'];
      return id.matches('MB-[2-9A-HJ-NP-Z]{10}')
        && d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.uid == request.auth.uid
        && d.accountEmail == request.auth.token.get('email', '')
        && validCustomer(d.customer)
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 60
        && d.subtotal is int && d.subtotal > 0 && d.subtotal <= 500000
        // keep in sync with OFFERS in src/config.ts
        && d.freeMiniCandle == (d.subtotal >= 599)
        && d.freeShipping == (d.subtotal >= 999)
        && d.contactConsent == true
        && str(d.note, 0, 1000)
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    // ── Catalogue (keep in sync with src/data/product-validate.ts) ──
    function slugOk(s, max) {
      return s is string && s.size() >= 1 && s.size() <= max && s.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    function rupees(n) {
      return n is int && n >= 1 && n <= 100000;
    }

    function validVariant(v) {
      return v is map && v.keys().hasOnly(['id', 'label', 'price']) && v.keys().hasAll(['id', 'label', 'price'])
        && v.id is string && v.id.matches('[a-z0-9]{1,12}')
        && str(v.label, 1, 60)
        && rupees(v.price);
    }

    // Rules can't loop, so check each of the (max 8) options by position.
    function validVariants(vs) {
      return vs is list && vs.size() >= 1 && vs.size() <= 8
        && validVariant(vs[0])
        && (vs.size() < 2 || validVariant(vs[1]))
        && (vs.size() < 3 || validVariant(vs[2]))
        && (vs.size() < 4 || validVariant(vs[3]))
        && (vs.size() < 5 || validVariant(vs[4]))
        && (vs.size() < 6 || validVariant(vs[5]))
        && (vs.size() < 7 || validVariant(vs[6]))
        && (vs.size() < 8 || validVariant(vs[7]));
    }

    function validNotes(ns) {
      return ns is list && ns.size() <= 5
        && (ns.size() < 1 || str(ns[0], 1, 200))
        && (ns.size() < 2 || str(ns[1], 1, 200))
        && (ns.size() < 3 || str(ns[2], 1, 200))
        && (ns.size() < 4 || str(ns[3], 1, 200))
        && (ns.size() < 5 || str(ns[4], 1, 200));
    }

    function validProduct(slug) {
      let d = request.resource.data;
      let keys = ['name', 'collection', 'design', 'price', 'unit', 'variants', 'setInfo', 'notes', 'family', 'tone', 'sort', 'active', 'bestseller', 'updatedAt'];
      return slugOk(slug, 60)
        && d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && str(d.name, 2, 120)
        && d.collection in ['candles', 'diwali']
        && (d.design == null || (d.design is int && d.design >= 1 && d.design <= 999))
        && rupees(d.price)
        && d.unit in ['', 'each', 'per pack']
        && validVariants(d.variants)
        && str(d.setInfo, 0, 200)
        && validNotes(d.notes)
        && (d.family == '' || slugOk(d.family, 40))
        && d.tone is string && d.tone.matches('#[0-9a-fA-F]{6}')
        && d.sort is int && d.sort >= 0 && d.sort <= 100000
        && d.active is bool
        && d.bestseller is bool
        && d.updatedAt == request.time;
    }

    // Public read: the website build fetches the catalogue (it's shown publicly anyway). Owner-only writes.
    match /products/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(slug);
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if isUser(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isUser(uid) && validProfile(request.resource.data);
      allow delete: if isUser(uid) || isAdmin();
    }

    match /orders/{orderId} {
      // Customers read only their own orders; the owner reads all.
      allow get, list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && validNewOrder(orderId);
      allow update, delete: if isAdmin();
    }

    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
