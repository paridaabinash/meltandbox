# Firebase web app config (Project settings → General → Your apps → Web app).
# These are public values; security is enforced by firestore.rules.
# Leave empty to run without a database — orders are then sent via WhatsApp only.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=

# Order emails: the Google Apps Script web-app URL (ends in /exec). Leave empty to disable.
PUBLIC_ORDER_EMAIL_URL=
