---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" noindex>
  <section class="wrap section center" style="max-width:560px">
    <p class="eyebrow">404</p>
    <h1>This flame has gone out</h1>
    <p class="lede center">The page you're looking for doesn't exist — but there's plenty of warmth in the shop.</p>
    <a href="/shop/" class="btn">Browse candles <Icon name="arrow" /></a>
  </section>
</Base>
