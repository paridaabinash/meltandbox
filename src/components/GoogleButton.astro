---
// "Continue with Google" button (Google's brand guidelines: white button, multicolour G).
interface Props {
  attr: string; // data attribute the page script binds to, e.g. "data-co-google"
}
const { attr } = Astro.props;
---

<button type="button" class="gbtn" {...{ [attr]: '' }}>
  <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
    <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.7 13.2l7.9 6.2C12.5 13.6 17.8 9.5 24 9.5z"></path>
    <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.7 6c4.5-4.2 6.9-10.3 6.9-17.7z"></path>
    <path fill="#FBBC05" d="M10.6 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.2C1 16.6 0 20.2 0 24s1 7.4 2.7 10.8l7.9-6.2z"></path>
    <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.7-6c-2.1 1.4-4.9 2.3-8.2 2.3-6.2 0-11.5-4.2-13.4-9.9l-7.9 6.2C6.6 42.6 14.6 48 24 48z"></path>
  </svg>
  <span>Continue with Google</span>
</button>

<style>
  .gbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 22px;
    border: 1.5px solid #dadce0;
    border-radius: 999px;
    background: #fff;
    color: #1f1f1f;
    font: 600 0.95rem var(--sans);
    cursor: pointer;
    transition:
      box-shadow 0.2s,
      background 0.2s;
  }
  .gbtn:hover {
    background: #f8f9fa;
    box-shadow: var(--shadow);
  }
  .gbtn[disabled] {
    opacity: 0.6;
    cursor: wait;
  }
</style>
