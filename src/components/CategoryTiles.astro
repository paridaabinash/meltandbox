---
// "Shop by category" photo tiles → /collections/<id>/. Below the fold everywhere, so photos are lazy.
import ProductImage from './ProductImage.astro';
import { CATEGORIES, type CategoryId } from '../data/products';
import { CATEGORY_GROUPS, bySlug } from '../data/catalog';

interface Props {
  /** Leave this category out (e.g. on its own page). */
  except?: CategoryId;
}
const { except } = Astro.props;
const tiles = CATEGORY_GROUPS.filter((g) => g.id !== except).map((g) => {
  const c = CATEGORIES[g.id];
  // Cover photo: the category's chosen cover if it's live, else its first product.
  const cover = bySlug(c.cover) ?? g.items[0];
  return { id: g.id, title: c.title, count: g.items.length, cover };
});
---

<ul class="cat-tiles">
  {
    tiles.map((t) => (
      <li>
        <a href={`/collections/${t.id}/`} class="cat-tile">
          <span class="cat-media">
            <ProductImage slug={t.cover.slug} alt="" sizes="(min-width: 1060px) 190px, (min-width: 760px) 31vw, 47vw" tone={t.cover.tone} class="cat-img" />
          </span>
          <span class="cat-copy">
            <b>{t.title}</b>
            <small>{t.count} {t.count === 1 ? 'design' : 'designs'}</small>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cat-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .cat-tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
  }
  @media (min-width: 1060px) {
    .cat-tiles {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .cat-tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--paper);
    border: 1px solid var(--sand);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .cat-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .cat-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--blush);
  }
  .cat-media :global(.cat-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cat-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px 12px;
  }
  .cat-copy b {
    font: 600 1rem/1.25 var(--serif);
  }
  .cat-copy small {
    font-size: 0.78rem;
    color: var(--cocoa-3);
  }
</style>
