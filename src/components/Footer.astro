---
import Icon from './Icon.astro';
import { SITE, igLink, waLink } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <p class="f-brand">Melt &amp; Box Co.</p>
      <p class="f-tag">{SITE.tagline}</p>
      <p class="f-copy">Handmade candles &amp; customised gift hampers. Small details, warm moments, and candles made to be remembered.</p>
    </div>
    <div>
      <p class="f-h">Shop</p>
      <a href="/shop/#candles">The Candle Collection</a>
      <a href="/shop/#diwali">Diwali Candle Collection</a>
      <a href="/#custom">Custom &amp; bulk orders</a>
      <a href="/account/">My account &amp; orders</a>
    </div>
    <div>
      <p class="f-h">Say hello</p>
      <a href={igLink} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> @{SITE.instagram}</a>
      <a href={waLink('Hi Melt & Box Co.! ')} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
      <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}><Icon name="phone" size={18} /> {SITE.phone}</a>
      <p class="muted f-founder">Founder: {SITE.founder}</p>
    </div>
  </div>
  <div class="wrap f-bottom">
    <span>© {year} Melt &amp; Box Co.</span>
    <span>Handmade with <Icon name="heart" size={13} class="f-heart" /> in India</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--cocoa);
    color: #e9ddd2;
    padding-top: 56px;
  }
  .footer-grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  .footer a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 0;
    color: #e9ddd2;
    text-decoration: none;
    font-size: 0.93rem;
  }
  .footer a:hover {
    color: var(--gold-2);
  }
  .f-brand {
    font: italic 600 1.7rem/1.1 var(--serif);
    color: #fff;
    margin: 0;
  }
  .f-tag {
    font: italic 0.95rem var(--serif);
    color: var(--rose-2);
  }
  .f-copy {
    max-width: 36ch;
    font-size: 0.92rem;
    color: #c9b8aa;
  }
  .f-h {
    font: 700 0.72rem/1 var(--sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-bottom: 12px;
  }
  .f-founder {
    margin-top: 10px;
    font-size: 0.85rem;
    color: #b5a294;
  }
  .f-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 40px;
    padding-block: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.8rem;
    color: #b5a294;
  }
  .f-bottom span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .f-bottom :global(.f-heart) {
    color: var(--rose-2);
    fill: var(--rose-2);
  }
</style>
