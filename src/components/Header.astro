---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoMark from '../assets/brand/logo-mark.png';
import { OFFERS, SITE, igLink, waLink } from '../config';
import { CATEGORIES, CATEGORY_IDS } from '../data/products';

const path = Astro.url.pathname;
// Desktop header links
const nav = [
  { href: '/shop/', label: 'Shop' },
  { href: '/diwali/', label: 'Diwali' },
  { href: '/daisy/', label: 'Daisy' },
  { href: '/bulk-orders/', label: 'Bulk orders' },
  { href: '/account/', label: 'Track order' },
];
// Mobile side sheet
const menuLinks = [
  { href: '/', label: 'Home' },
  { href: '/shop/', label: 'Shop all' },
  { href: '/diwali/', label: 'Diwali special' },
  { href: '/daisy/', label: 'Daisy collection' },
  { href: '/#custom', label: 'Make your own' },
  { href: '/bulk-orders/', label: 'Bulk & corporate gifting' },
  { href: '/account/', label: 'Track order / My orders' },
  { href: '/contact/', label: 'Contact us' },
];
---

<div class="announce">
  <div class="announce-track">
    <span><Icon name="gift" size={15} /> Free mini candle above ₹{OFFERS.freeMiniCandleAbove}/-</span>
    <span><Icon name="truck" size={15} /> Free shipping above ₹{OFFERS.freeShippingAbove}/-</span>
    <span class="hide-sm"><Icon name="tag" size={15} /> Direct wholesale pricing available</span>
  </div>
</div>

<header class="header">
  <div class="wrap header-in">
    <button type="button" class="menu-btn" data-menu-open aria-label="Open menu" aria-haspopup="dialog">
      <span></span><span></span><span></span>
    </button>

    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <Image src={logoMark} alt="" width={78} height={40} densities={[1, 2]} loading="eager" class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">Melt &amp; Box Co.</span>
        <span class="brand-tag">{SITE.tagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
    </nav>

    <div class="actions">
      <a href="/account/" class="icon-btn acct-btn" data-account aria-label="My account">
        <Icon name="user" size={23} />
        <span class="acct-initial" data-account-initial hidden></span>
      </a>
      <button class="icon-btn cart-btn" type="button" data-cart-open aria-label="Open cart">
        <Icon name="bag" size={24} />
        <span class="cart-count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: left side sheet (<dialog>, opened/closed by cart.ts) -->
<dialog class="menu-sheet" data-menu aria-label="Menu">
  <div class="ms-in">
    <div class="ms-head">
      <a href="/" class="ms-brand">
        <Image src={logoMark} alt="" width={78} height={40} densities={[1, 2]} loading="lazy" class="ms-mark" />
        <span class="brand-name">Melt &amp; Box Co.</span>
        <span class="brand-tag">{SITE.tagline}</span>
      </a>
      <button type="button" class="ms-close" data-menu-close aria-label="Close menu"><Icon name="close" /></button>
    </div>
    <nav aria-label="Mobile">
      <ul class="ms-list">
        {
          menuLinks.map((n) => (
            <li>
              <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="ms-sub">Shop by category</p>
      <ul class="ms-cats">
        {
          CATEGORY_IDS.map((id) => (
            <li>
              <a href={`/collections/${id}/`} aria-current={path === `/collections/${id}/` ? 'page' : undefined}>
                {CATEGORIES[id].short}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ms-cta">
      <a href={waLink('Hi Melt & Box Co.!')} class="btn btn-wa" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
      <a href={igLink} class="ms-ig" target="_blank" rel="noopener" aria-label={`Instagram @${SITE.instagram}`}><Icon name="instagram" /></a>
    </div>
  </div>
</dialog>

<style>
  .announce {
    background: var(--cocoa);
    color: var(--gold-2);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    overflow: hidden;
  }
  .announce-track {
    display: flex;
    justify-content: center;
    gap: clamp(16px, 5vw, 56px);
    padding: 8px var(--gutter);
    white-space: nowrap;
  }
  .announce span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 560px) {
    .hide-sm {
      display: none !important;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 246 239 / 0.86);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--sand);
  }
  .header-in {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 84px 1fr 84px;
    align-items: center;
    gap: 6px;
  }
  .brand {
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    text-align: center;
    text-decoration: none;
    line-height: 1.1;
  }
  /* The logo art sits on cream; multiply makes that cream disappear into the header. */
  .brand :global(.brand-mark),
  .ms-brand :global(.ms-mark) {
    width: auto;
    height: 26px;
    mix-blend-mode: multiply;
  }
  .ms-brand :global(.ms-mark) {
    display: block;
    height: 34px;
    margin-bottom: 4px;
  }
  .brand-name {
    display: block;
    white-space: nowrap;
    font: 600 1.3rem/1.1 var(--serif);
    letter-spacing: 0.01em;
  }
  /* Phones: logo art + name; the tagline returns on desktop (it's also in the footer badge). */
  .header .brand-tag {
    display: none;
  }
  .brand-tag {
    display: block;
    white-space: nowrap;
    font: 0.72rem/1.4 var(--serif);
    color: var(--rose);
  }
  .nav {
    display: none;
  }
  .nav a {
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--cocoa-2);
    padding: 6px 2px;
    background: linear-gradient(var(--gold), var(--gold)) no-repeat 0 100% / 0 1.5px;
    transition: background-size 0.25s, color 0.2s;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--cocoa);
    background-size: 100% 1.5px;
  }

  .actions {
    justify-self: end;
    display: flex;
    gap: 2px;
  }
  .icon-btn {
    position: relative;
    width: 41px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background 0.2s;
  }
  .icon-btn:hover {
    background: var(--blush);
  }
  .icon-btn {
    color: var(--cocoa);
  }
  .acct-initial {
    position: absolute;
    inset: 7px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--cocoa);
    color: var(--gold-2);
    font: 600 1rem var(--serif);
  }
  .acct-initial[hidden] {
    display: none;
  }
  .cart-count {
    position: absolute;
    top: 3px;
    right: 1px;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--rose);
    color: #fff;
    font: 700 0.68rem/19px var(--sans);
    text-align: center;
  }
  .cart-count.bump {
    animation: bump 0.4s ease;
  }
  @keyframes bump {
    40% {
      transform: scale(1.35);
    }
  }

  /* mobile menu button + left side sheet */
  .menu-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    gap: 5px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    width: 20px;
    height: 1.7px;
    background: var(--cocoa);
    border-radius: 2px;
  }
  .menu-sheet {
    margin: 0 auto 0 0;
    width: min(340px, 86vw);
    max-width: 86vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--cream);
    color: var(--cocoa);
    box-shadow: var(--shadow-lg);
  }
  .menu-sheet[open] {
    animation: sheet-in 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .menu-sheet::backdrop {
    background: rgb(40 25 20 / 0.42);
    backdrop-filter: blur(2px);
  }
  @keyframes sheet-in {
    from {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-sheet[open] {
      animation: none;
    }
  }
  .ms-in {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 16px 22px calc(20px + env(safe-area-inset-bottom));
  }
  .ms-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 10px;
  }
  .ms-brand {
    text-decoration: none;
    line-height: 1.1;
  }
  .ms-close {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--cocoa-2);
    cursor: pointer;
  }
  .ms-close:hover {
    background: var(--blush);
  }
  .ms-list,
  .ms-cats {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ms-list a {
    display: block;
    padding: 14px 2px;
    border-bottom: 1px solid var(--sand);
    text-decoration: none;
    font-size: 1.02rem;
    font-weight: 500;
  }
  .ms-list a[aria-current='page'],
  .ms-cats a[aria-current='page'] {
    color: var(--rose);
    font-weight: 700;
  }
  .ms-sub {
    margin: 22px 0 8px;
    font: 700 0.72rem/1.4 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cocoa-3);
  }
  .ms-cats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ms-cats a {
    display: block;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    background: var(--paper);
    border: 1px solid var(--sand);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .ms-cta {
    display: flex;
    gap: 10px;
    margin-top: auto;
    padding-top: 24px;
  }
  .ms-cta .btn {
    flex: 1;
  }
  .ms-ig {
    flex: none;
    width: 48px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--blush);
    color: var(--rose);
  }

  @media (max-width: 380px) {
    .brand-name {
      font-size: 1.15rem;
    }
  }
  @media (min-width: 900px) {
    .menu-btn {
      display: none;
    }
    .header-in {
      grid-template-columns: auto 1fr auto;
    }
    .brand {
      justify-self: start;
      flex-direction: row;
      gap: 12px;
      text-align: left;
    }
    .brand :global(.brand-mark) {
      height: 40px;
    }
    .brand-name {
      font-size: 1.45rem;
    }
    .header .brand-tag {
      display: block;
    }
    .nav {
      display: flex;
      gap: 28px;
      justify-self: end;
      margin-right: 8px;
    }
  }
</style>
